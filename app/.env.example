# Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key -- safe to ship. Grants SELECT on creators only.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Service role key -- REQUIRED ONLY FOR UPLOADS. Bypasses RLS entirely.
# Anyone with the packaged app can extract this. Leave it unset to run the app
# in read-only mode; the Upload button stays disabled and explains why.
VITE_SUPABASE_SERVICE_ROLE_KEY=

# Lets the app's "Sync now" button pull the Google Sheet on demand.
# Optional: without it the button is hidden and the 15-minute cron still runs.
VITE_SYNC_SECRET=
